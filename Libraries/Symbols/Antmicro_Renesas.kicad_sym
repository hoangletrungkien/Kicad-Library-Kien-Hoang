			)
		)
		(property "ki_keywords" "OSCILLATOR, LVDS"
			(at 0 0 0)
			(show_name no)
			(do_not_autoplace no)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(embedded_fonts no)
	)
)
